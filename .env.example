# ==============================================================================
# JOB-BOT: Prepackaged Docker Compose Configuration (.env)
# Everything comes prebuilt & prewired—fill out Sections 1, 2, & 3 before launch!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED: OpenCode Claude Code Harness Configuration
# Docs: https://opencode.ai/v2/docs/console/harnesses/claude-code
# ------------------------------------------------------------------------------
ANTHROPIC_BASE_URL=https://opencode.ai/inference/anthropic
ANTHROPIC_AUTH_TOKEN=oc_sk_replace_with_your_opencode_key
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-5-5
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-5-5

# ------------------------------------------------------------------------------
# 2. REQUIRED: Gmail IMAP (App Password) for 2FA/OTPs & Recruiter Replies
# Create a 16-char App Password at: https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993

# ------------------------------------------------------------------------------
# 3. REQUIRED: Unique Security Secrets & Remote Origin
# Generate secrets with:
#   SECRET_MASTER_KEY:       openssl rand -base64 32
#   ATS_VAULT_MASTER_SECRET: openssl rand -hex 32
# (If ATS_VAULT_MASTER_SECRET is left as REPLACE_*, the terminal container will
#  auto-generate and persist a unique 64-char secret on first startup.)
# ------------------------------------------------------------------------------
SECRET_MASTER_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32_BYTES_KEY
ATS_VAULT_MASTER_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_VAULT_SECRET

# Set PUBLIC_URL / APP_URL / CORS_ORIGINS to the URL you use to access the dashboard
# (e.g. https://jobs.yourdomain.com or http://100.x.y.z:8080 over Tailscale/SSH tunnel)
PUBLIC_PORT=8080
PUBLIC_URL=http://localhost:8080
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4100

# ------------------------------------------------------------------------------
# 4. Database & Pre-Wired Defaults
# Note: If you change POSTGRES_PASSWORD, docker-compose automatically interpolates
# it into DATABASE_URL unless DATABASE_URL is explicitly uncommented below.
# ------------------------------------------------------------------------------
GHCR_REPO=heretek-ai/job-bot
IMAGE_TAG=latest

POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_secret_password
POSTGRES_DB=jobpilot
# DATABASE_URL=postgresql://jobpilot:jobpilot_secret_password@postgres:5432/jobpilot

ATS_DEFAULT_PASSWORD_PREFIX=JobBot#2026!
SESSION_TTL_DAYS=30
SUPER_ADMIN_EMAIL=admin@jobbot.local
LOG_LEVEL=info

# Optional: JobPilot Personal Access Token (auto-discovered from pilot.json once paired in UI)
JOBPILOT_API_TOKEN=

# Stealth Browser & Optional Secondary Firefox MCP
CLOAKBROWSER_CDP_URL=http://cloakbrowser:9222
CLOAKBROWSER_TIMEZONE=America/New_York
CLOAKBROWSER_LOCALE=en-US
BROWSER_PROXY_URL=
ENABLE_INVISIBLE_PLAYWRIGHT_FIREFOX_MCP=false

# Optional Paid Token CAPTCHA Solvers (Layer 2 fallback if CloakBrowser checkbox triggers grid)
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=
