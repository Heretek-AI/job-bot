# ==============================================================================
# JOB-BOT: Prepackaged Docker Compose Configuration (.env)
# Everything comes prebuilt & prewired—you only need to fill out Sections 1 & 2!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED: OpenCode Claude Code Harness Configuration
# Docs: https://opencode.ai/v2/docs/console/harnesses/claude-code
# ------------------------------------------------------------------------------
ANTHROPIC_BASE_URL=https://opencode.ai/inference/anthropic
ANTHROPIC_AUTH_TOKEN=oc_sk_replace_with_your_opencode_key
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-5-5
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-5-5

# ------------------------------------------------------------------------------
# 2. REQUIRED: Gmail IMAP (App Password) for 2FA/OTPs & Recruiter Replies
# Create a 16-char App Password at: https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993

# ------------------------------------------------------------------------------
# 3. Pre-Wired Defaults (No changes needed unless customizing)
# ------------------------------------------------------------------------------
PUBLIC_PORT=8080
GHCR_REPO=heretek-ai/job-bot

# Database & Encryption Secrets (pre-populated with valid 32-byte keys; feel free to rotate)
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_secret_password
POSTGRES_DB=jobpilot
DATABASE_URL=postgresql://jobpilot:jobpilot_secret_password@postgres:5432/jobpilot
SECRET_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
ATS_VAULT_MASTER_SECRET=change_this_to_a_32_byte_random_master_secret_key!
ATS_DEFAULT_PASSWORD_PREFIX=JobBot#2026!

SESSION_TTL_DAYS=30
SUPER_ADMIN_EMAIL=admin@jobbot.local
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4100
APP_URL=http://localhost:8080
LOG_LEVEL=info

# Stealth Browser & Optional Secondary Firefox MCP
CLOAKBROWSER_CDP_URL=http://cloakbrowser:9222
CLOAKBROWSER_TIMEZONE=America/New_York
CLOAKBROWSER_LOCALE=en-US
BROWSER_PROXY_URL=
ENABLE_INVISIBLE_PLAYWRIGHT_FIREFOX_MCP=true

# Optional Paid Token CAPTCHA Solvers (Layer 2 fallback if CloakBrowser checkbox triggers grid)
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=
